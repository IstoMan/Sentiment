# Simple UBI-based nginx proxy
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8-1794186349

RUN microdnf install -y nginx && \
    microdnf clean all && \
    mkdir -p /var/cache/nginx /var/log/nginx /var/run && \
    chown -R 1001:0 /var/cache/nginx /var/log/nginx /var/run /etc/nginx && \
    chmod -R g=u /var/cache/nginx /var/log/nginx /var/run /etc/nginx

COPY nginx.conf /etc/nginx/nginx.conf

USER 1001

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
