# UBI-based nginx reverse proxy with dynamic resolver
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8-1794186349

ARG VERSION=1.0.0
ENV VERSION=${VERSION}

LABEL name="sentiment-proxy" \
      version="${VERSION}" \
      description="Nginx reverse proxy for Sentiment Analyzer" \
      maintainer="DO188 Student"

RUN microdnf install -y nginx && \
    microdnf clean all && \
    mkdir -p /var/cache/nginx /var/log/nginx /var/run /etc/nginx && \
    chown -R 1001:0 /var/cache/nginx /var/log/nginx /var/run /etc/nginx && \
    chmod -R g=u /var/cache/nginx /var/log/nginx /var/run /etc/nginx

COPY nginx.conf /etc/nginx/nginx.conf
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/entrypoint.sh

USER 1001

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
